# PostgreSQL Database
# DB_* are the canonical names docker-compose uses (db service, exporter DSN).
# The api service maps them onto the POSTGRES_* variables the gateway reads.
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname

# Postgres Exporter


# Set these only when running the gateway outside Compose, which otherwise
# supplies them from the DB_* values above.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# LLM API (OpenAI-compatible chat completions endpoint)
OPENAI_API_KEY=
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# API Gateway
# REQUIRED, minimum 32 characters — signs every JWT the gateway issues, and the
# app refuses to start if it is shorter. Generate one with: openssl rand -hex 32
PROXY_SECRET_KEY=
# Optional overrides (defaults shown):
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Classifier (Layer 2)
# The gateway owns the thresholds: the classifier only returns a score.
# Both must be within [0,1] and BLOCK must be >= REVIEW, or the app refuses
# to start. These are placeholders pending calibration, not measured values.
# CLASSIFIER_URL=http://ml:7000
# CLASSIFIER_TIMEOUT_SECONDS=2.0
# CLASSIFIER_BLOCK_THRESHOLD=0.90
# CLASSIFIER_REVIEW_THRESHOLD=0.60
